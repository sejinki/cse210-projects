@startuml
title Scipture Memorization Program

class Program {
    + Main(args : string[])
}

class Scripture {

    - _reference : Reference
    - _words : List<Word>

    + Scripture(reference : Reference, text : string)
    + Display(): void
    + HideWords() : void
    + GetrenderedText() : string
    + IsCompletelyHidden() : bool
    
}

Class Reference {
    + GetDisplayText() : string
    + Reference(book : string, chapter : int, verse : int)
    + Reference(book : string, chapter : int, startVerse : int, endVerse : int)
    + GetBook() : string
    + GetChapter() : int
    + GetVerse() : int
    + GetEndVerse() : int

    - _book : string
    - _chapter : int
    - _verse : int
    - _endVerse : int
}

Class Word {
    + Word(text : string)
    + Word(text : string, isHidden : bool)
    + HideWord() : void
    + ShowWord() : void
    + GetDisplayText() : string


    - _text : string
    - _isHidden : bool
    
}

 Program --> Scripture
 Scripture "1" --> "1" Reference
 Scripture "1" --> "*" Word

@enduml