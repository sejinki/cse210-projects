@startuml

title Journal Program

class Journal {
    -entries : List<Entry>
    + AddEntry(entry : Entry)
    + SaveToFile() : void
    + LoadtoFile() : void
    + DisplayEntries() : void

}

Class Entry {
    - date : DateTime
    - prompt : string
    - text : string
    + Display() : void
}


Class PromptGenerator {
    + GetRandomPrompt() : string
}


class Program{
    + Main() : void
}

Journal "1" --> "*" Entry
Program --> Journal
Program --> PromptGenerator
PromptGenerator --> Entry


' Journal has many entries, program starts journal and prompt generator.
' prompt generator gives random prompts for Entry to use.

@enduml
